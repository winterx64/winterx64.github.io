---
// Writing component refactored for OS window sizing
---
<div class="p-6 md:p-8 space-y-8">
  <div class="space-y-2">
    <span class="font-mono text-xs text-[#4F9DFF]">// 06. JOURNAL ARCHIVE</span>
    <h2 class="text-2xl md:text-3xl font-heading font-bold text-white tracking-tight">
      Technical Writing
    </h2>
  </div>

  <div class="border border-border-site rounded bg-surface-site overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-border-site bg-[#181818] font-mono text-[9px] text-text-secondary uppercase">
            <th class="py-3 px-4">// ID</th>
            <th class="py-3 px-4">Topic</th>
            <th class="py-3 px-4 w-1/2">Journal Entry Title</th>
            <th class="py-3 px-4 text-right">Date</th>
          </tr>
        </thead>
        <tbody class="font-mono text-[11px] text-text-secondary divide-y divide-border-site/50">
          <tr class="hover:bg-white/[0.02] hover:text-white transition-colors group">
            <td class="py-3 px-4 text-[#4F9DFF]">LOG_004</td>
            <td class="py-3 px-4 text-white">PROTOCOLS</td>
            <td class="py-3 px-4 font-sans font-medium text-white group-hover:text-[#4F9DFF]">
              <a href="#writing">Designing USMP: Low-Overhead Cryptography for BLE</a>
            </td>
            <td class="py-3 px-4 text-right">2026-05-12</td>
          </tr>
          <tr class="hover:bg-white/[0.02] hover:text-white transition-colors group">
            <td class="py-3 px-4 text-[#4F9DFF]">LOG_003</td>
            <td class="py-3 px-4 text-white">ENGINEERING</td>
            <td class="py-3 px-4 font-sans font-medium text-white group-hover:text-[#4F9DFF]">
              <a href="#writing">First Principles: Why We Choose Rust for Embedded</a>
            </td>
            <td class="py-3 px-4 text-right">2026-04-18</td>
          </tr>
          <tr class="hover:bg-white/[0.02] hover:text-white transition-colors group">
            <td class="py-3 px-4 text-[#4F9DFF]">LOG_002</td>
            <td class="py-3 px-4 text-white">ARCHITECTURE</td>
            <td class="py-3 px-4 font-sans font-medium text-white group-hover:text-[#4F9DFF]">
              <a href="#writing">Building Feedback Pipelines: High-Throughput Flask</a>
            </td>
            <td class="py-3 px-4 text-right">2026-03-05</td>
          </tr>
          <tr class="hover:bg-white/[0.02] hover:text-white transition-colors group">
            <td class="py-3 px-4 text-[#4F9DFF]">LOG_001</td>
            <td class="py-3 px-4 text-white">STARTUPS</td>
            <td class="py-3 px-4 font-sans font-medium text-white group-hover:text-[#4F9DFF]">
              <a href="#writing">The Founder-Engineer Dilemma: Speed vs. Integrity</a>
            </td>
            <td class="py-3 px-4 text-right">2026-01-20</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
