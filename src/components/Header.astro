---
// Minimal Premium Navigation Header
---
<header class="fixed top-0 left-0 right-0 z-30 px-4 py-4 md:px-12 backdrop-blur-md border-b border-border-site/50 bg-bg-site/80">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    
    <!-- Logo -->
    <a href="#home" class="flex items-center gap-2 group">
      <div class="flex items-center font-mono text-[11px] tracking-widest text-[#4F9DFF] bg-[#4F9DFF]/10 border border-[#4F9DFF]/20 px-2.5 py-1 rounded">
        SYSTEM.OS v2.6
      </div>
      <div class="hidden sm:block">
        <div class="text-sm font-heading font-bold tracking-tight text-white group-hover:text-[#4F9DFF] transition-colors">
          Akhil B Xavier
        </div>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 font-mono text-xs">
      <a href="#about" class="text-text-secondary hover:text-white transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-[#4F9DFF] after:transition-all hover:after:w-full">
        // 01. ABOUT
      </a>
      <a href="#projects" class="text-text-secondary hover:text-white transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-[#4F9DFF] after:transition-all hover:after:w-full">
        // 02. PROJECTS
      </a>
      <a href="#philosophy" class="text-text-secondary hover:text-white transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-[#4F9DFF] after:transition-all hover:after:w-full">
        // 03. FLOW
      </a>
      <a href="#interests" class="text-text-secondary hover:text-white transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-[#4F9DFF] after:transition-all hover:after:w-full">
        // 04. SCOPE
      </a>
      <a href="#now" class="text-text-secondary hover:text-white transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-[#4F9DFF] after:transition-all hover:after:w-full">
        // 05. NOW
      </a>
      <a href="#writing" class="text-text-secondary hover:text-white transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-[#4F9DFF] after:transition-all hover:after:w-full">
        // 06. LOGS
      </a>
      <a href="#contact" class="text-text-secondary hover:text-white transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-[#4F9DFF] after:transition-all hover:after:w-full">
        // 07. CONTACT
      </a>
    </nav>

    <!-- Right Side CTA/Actions -->
    <div class="flex items-center gap-4">
      <a
        href="#contact"
        class="hidden sm:inline-flex items-center gap-1.5 font-mono text-xs border border-border-site hover:border-white text-text-secondary hover:text-white px-3.5 py-1.5 rounded transition-all"
      >
        SYS.REQ
      </a>
      
      <!-- Mobile Menu Button -->
      <button
        id="mobileBtn"
        aria-label="Toggle Mobile Menu"
        class="md:hidden p-2 rounded border border-border-site hover:border-white transition-colors group"
      >
        <div class="hamburger">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer -->
<div id="mobileMenu" class="fixed inset-0 z-50 hidden">
  <div class="mobile-menu-backdrop absolute inset-0 bg-black/80 backdrop-blur-sm"></div>
  <div class="mobile-menu absolute right-0 top-0 h-full w-[280px] bg-surface-site border-l border-border-site p-6 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between mb-8">
        <span class="font-mono text-xs text-[#4F9DFF]">// MENU</span>
        <button id="closeMobile" class="p-1 rounded border border-border-site hover:border-white text-text-secondary hover:text-white transition-colors">
          <i class="fa-solid fa-times text-sm"></i>
        </button>
      </div>

      <nav class="flex flex-col gap-6 font-mono text-sm">
        <a href="#about" class="mobile-nav-item py-1 text-text-secondary hover:text-white">// 01. ABOUT</a>
        <a href="#projects" class="mobile-nav-item py-1 text-text-secondary hover:text-white">// 02. PROJECTS</a>
        <a href="#philosophy" class="mobile-nav-item py-1 text-text-secondary hover:text-white">// 03. FLOW</a>
        <a href="#interests" class="mobile-nav-item py-1 text-text-secondary hover:text-white">// 04. SCOPE</a>
        <a href="#now" class="mobile-nav-item py-1 text-text-secondary hover:text-white">// 05. NOW</a>
        <a href="#writing" class="mobile-nav-item py-1 text-text-secondary hover:text-white">// 06. LOGS</a>
        <a href="#contact" class="mobile-nav-item py-1 text-text-secondary hover:text-white">// 07. CONTACT</a>
      </nav>
    </div>

    <div class="border-t border-border-site pt-6 font-mono text-[10px] text-text-secondary space-y-2">
      <div>IP: 192.168.1.104</div>
      <div>SECURE PORTFOLIO OS v2.6</div>
    </div>
  </div>
</div>

<style>
  /* Hamburger styling */
  .hamburger {
    display: flex;
    flex-direction: column;
    width: 16px;
    height: 12px;
    justify-content: space-between;
    cursor: pointer;
  }
  .hamburger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background-color: var(--color-text-secondary);
    transition: all 0.2s ease-in-out;
  }
  .hamburger.active span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
    background-color: white;
  }
  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.active span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
    background-color: white;
  }
</style>

<script>
  // Mobile menu scripting
  const mobileBtn = document.getElementById("mobileBtn");
  const mobileMenu = document.getElementById("mobileMenu");
  const closeMobile = document.getElementById("closeMobile");

  if (mobileBtn && mobileMenu && closeMobile) {
    const mobileMenuContent = mobileMenu.querySelector(".mobile-menu");
    const hamburger = mobileBtn.querySelector(".hamburger");

    function openMobileMenu() {
      mobileMenu?.classList.remove("hidden");
      hamburger?.classList.add("active");
      mobileMenuContent?.classList.add("slide-in");
      mobileMenuContent?.classList.remove("slide-out");
      document.body.style.overflow = "hidden";
    }

    function closeMobileMenu() {
      mobileMenuContent?.classList.add("slide-out");
      mobileMenuContent?.classList.remove("slide-in");
      hamburger?.classList.remove("active");
      document.body.style.overflow = "";

      setTimeout(() => {
        mobileMenu?.classList.add("hidden");
      }, 300);
    }

    mobileBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (mobileMenu.classList.contains("hidden")) {
        openMobileMenu();
      } else {
        closeMobileMenu();
      }
    });

    closeMobile.addEventListener("click", closeMobileMenu);

    mobileMenu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).classList.contains("mobile-menu-backdrop")) {
        closeMobileMenu();
      }
    });

    document.querySelectorAll(".mobile-nav-item").forEach((link) => {
      link.addEventListener("click", () => closeMobileMenu());
    });
  }

  // Smooth scroll support with active menu tracking
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (this: HTMLAnchorElement, e) {
      const targetId = this.getAttribute("href");
      if (targetId && targetId !== "#") {
        const target = document.querySelector(targetId);
        if (target) {
          e.preventDefault();
          const headerOffset = 90;
          const elementPosition = target.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.scrollY - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });
        }
      }
    });
  });
</script>
