---
// Contact component refactored for OS window sizing
---
<div class="p-6 md:p-8 space-y-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column -->
    <div class="lg:col-span-5 space-y-4">
      <span class="font-mono text-xs text-[#4F9DFF]">// 07. CONNECT ENDPOINTS</span>
      <h2 class="text-2xl font-heading font-bold text-white tracking-tight">
        Connect Secure Channel
      </h2>
      <p class="text-text-secondary text-xs leading-relaxed font-sans">
        Have systems to build, products to engineer, or companies to scale? Reach out through direct endpoints.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="lg:col-span-7 w-full">
      <div class="tech-border rounded bg-surface-site p-4 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <div class="space-y-1">
            <div class="font-mono text-[9px] text-text-secondary">SYS.EMAIL</div>
            <div class="flex items-center justify-between border border-border-site p-2.5 bg-bg-site rounded">
              <span class="font-mono text-[11px] text-white">winterx64.work@gmail.com</span>
              <button
                id="copyEmailBtn"
                class="font-mono text-[8px] bg-white text-black hover:bg-[#4F9DFF] hover:text-black px-2 py-0.5 rounded transition-colors"
              >
                COPY
              </button>
            </div>
          </div>

          <div class="space-y-1">
            <div class="font-mono text-[9px] text-text-secondary">SYS.GITHUB</div>
            <a
              href="https://github.com/winterx64"
              target="_blank"
              class="flex items-center justify-between border border-border-site p-2.5 bg-bg-site rounded hover:border-white transition-colors group"
            >
              <span class="font-mono text-[11px] text-white">github.com/winterx64</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[9px] text-text-secondary group-hover:text-white"></i>
            </a>
          </div>

          <div class="space-y-1">
            <div class="font-mono text-[9px] text-text-secondary">SYS.LINKEDIN</div>
            <a
              href="https://linkedin.com/in/winterx64"
              target="_blank"
              class="flex items-center justify-between border border-border-site p-2.5 bg-bg-site rounded hover:border-white transition-colors group"
            >
              <span class="font-mono text-[11px] text-white">linkedin/in/winterx64</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[9px] text-text-secondary group-hover:text-white"></i>
            </a>
          </div>

          <div class="space-y-1">
            <div class="font-mono text-[9px] text-text-secondary">GATEWAY_STATUS</div>
            <div class="border border-border-site p-2.5 bg-bg-site rounded flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#4F9DFF] animate-pulse"></span>
              <span class="font-mono text-[9px] text-[#A1A1AA]">SECURE TUNNEL ACTIVE</span>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>
</div>

<script>
  const copyBtn = document.getElementById("copyEmailBtn");
  const emailText = "winterx64.work@gmail.com";
  if (copyBtn) {
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText(emailText).then(() => {
        const originalText = copyBtn.textContent;
        copyBtn.textContent = "COPIED";
        copyBtn.classList.remove("bg-white", "text-black");
        copyBtn.classList.add("bg-green-500", "text-black");
        
        setTimeout(() => {
          copyBtn.textContent = originalText;
          copyBtn.classList.add("bg-white", "text-black");
          copyBtn.classList.remove("bg-green-500", "text-black");
        }, 2000);
      });
    });
  }
</script>
