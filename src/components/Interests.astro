---
// Interests component refactored for OS window sizing
---
<div class="p-6 md:p-8 space-y-8">
  <div class="space-y-2">
    <span class="font-mono text-xs text-[#4F9DFF]">// 04. TECHNICAL DOMAINS</span>
    <h2 class="text-2xl md:text-3xl font-heading font-bold text-white tracking-tight">
      Engineering Scope
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    
    <!-- Interest 1 -->
    <div class="tech-card rounded p-5 relative overflow-hidden group spotlight-card" id="int-card-1">
      <div class="absolute right-3 top-3 font-mono text-[8px] text-[#4F9DFF]/40">[SYS.CORE]</div>
      <div class="space-y-2">
        <div class="font-mono text-[10px] text-[#A1A1AA]">01 // SYSTEMS</div>
        <h3 class="text-base font-bold text-white font-heading">Backend Systems</h3>
        <p class="text-text-secondary text-[11px] leading-relaxed font-sans">
          High-throughput API gateways, database indexes, and cache layers.
        </p>
      </div>
    </div>

    <!-- Interest 2 -->
    <div class="tech-card rounded p-5 relative overflow-hidden group spotlight-card" id="int-card-2">
      <div class="absolute right-3 top-3 font-mono text-[8px] text-[#4F9DFF]/40">[MCU.FIRM]</div>
      <div class="space-y-2">
        <div class="font-mono text-[10px] text-[#A1A1AA]">02 // EMBEDDED</div>
        <h3 class="text-base font-bold text-white font-heading">Embedded Systems</h3>
        <p class="text-text-secondary text-[11px] leading-relaxed font-sans">
          Low-level firmware for microcontrollers with timed interrupts.
        </p>
      </div>
    </div>

    <!-- Interest 3 -->
    <div class="tech-card rounded p-5 relative overflow-hidden group spotlight-card" id="int-card-3">
      <div class="absolute right-3 top-3 font-mono text-[8px] text-[#4F9DFF]/40">[NET.PRTCL]</div>
      <div class="space-y-2">
        <div class="font-mono text-[10px] text-[#A1A1AA]">03 // TRANSACT</div>
        <h3 class="text-base font-bold text-white font-heading">Protocol Design</h3>
        <p class="text-text-secondary text-[11px] leading-relaxed font-sans">
          Binary-encoded packet frame structures and cryptographic integrity.
        </p>
      </div>
    </div>

    <!-- Interest 4 -->
    <div class="tech-card rounded p-5 relative overflow-hidden group spotlight-card" id="int-card-4">
      <div class="absolute right-3 top-3 font-mono text-[8px] text-[#4F9DFF]/40">[DEV.TOOL]</div>
      <div class="space-y-2">
        <div class="font-mono text-[10px] text-[#A1A1AA]">04 // DEV.OPS</div>
        <h3 class="text-base font-bold text-white font-heading">Developer Tools</h3>
        <p class="text-text-secondary text-[11px] leading-relaxed font-sans">
          Compiler extensions, custom command-line lines, and VSCode modules.
        </p>
      </div>
    </div>

    <!-- Interest 5 -->
    <div class="tech-card rounded p-5 relative overflow-hidden group spotlight-card" id="int-card-5">
      <div class="absolute right-3 top-3 font-mono text-[8px] text-[#4F9DFF]/40">[PRD.ENG]</div>
      <div class="space-y-2">
        <div class="font-mono text-[10px] text-[#A1A1AA]">05 // FULL.STK</div>
        <h3 class="text-base font-bold text-white font-heading">Product Engineering</h3>
        <p class="text-text-secondary text-[11px] leading-relaxed font-sans">
          Designing lightweight client engines and pixel-perfect layouts.
        </p>
      </div>
    </div>

    <!-- Interest 6 -->
    <div class="tech-card rounded p-5 relative overflow-hidden group spotlight-card" id="int-card-6">
      <div class="absolute right-3 top-3 font-mono text-[8px] text-[#4F9DFF]/40">[AI.INFRA]</div>
      <div class="space-y-2">
        <div class="font-mono text-[10px] text-[#A1A1AA]">06 // MODEL</div>
        <h3 class="text-base font-bold text-white font-heading">AI Systems</h3>
        <p class="text-text-secondary text-[11px] leading-relaxed font-sans">
          Pipelines, local model inference optimization, and database indices.
        </p>
      </div>
    </div>

  </div>
</div>

<script>
  const intIds = ["int-card-1", "int-card-2", "int-card-3", "int-card-4", "int-card-5", "int-card-6"];
  intIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        el.style.setProperty("--mouse-x", `${x}px`);
        el.style.setProperty("--mouse-y", `${y}px`);
      });
    }
  });
</script>
