---
// Minimal footer status bar
---
<footer class="max-w-7xl mx-auto px-6 md:px-12 py-12 border-t border-border-site/50 relative z-10">
  <div class="flex flex-col md:flex-row items-center justify-between gap-6 font-mono text-[10px] text-text-secondary">
    <div>
      © <span id="year">2026</span> Akhil B Xavier. Built with Astro & Bun.
    </div>
    
    <!-- System Telemetry info in footer -->
    <div class="flex flex-wrap justify-center items-center gap-4">
      <span>LAT: 9.9312° N</span>
      <span>LON: 76.2673° E</span>
      <span class="text-border-site">|</span>
      <span>ENV: PRODUCTION</span>
      <span class="text-border-site">|</span>
      <span id="footer-time">UTC: 12:00:00</span>
    </div>
  </div>
</footer>

<script>
  // Update year
  const yearSpan = document.getElementById("year");
  if (yearSpan) {
    yearSpan.textContent = new Date().getFullYear().toString();
  }

  // Update real UTC time
  const timeSpan = document.getElementById("footer-time");
  function updateTime() {
    if (timeSpan) {
      const now = new Date();
      timeSpan.textContent = `UTC: ${now.toUTCString().split(' ')[4]}`;
    }
  }
  updateTime();
  setInterval(updateTime, 1000);
</script>
