---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Akhil B Xavier — Product Engineer & Founder" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>

    <!-- SEO + Social -->
    <meta
      name="description"
      content="Akhil B Xavier — Product Engineer, Founder, Systems Thinker. My work sits at the intersection of product engineering, backend systems, embedded technology, and secure communication."
    />
    <meta property="og:title" content="Akhil B Xavier — Product Engineer & Founder" />
    <meta
      property="og:description"
      content="Digital headquarters of a Product Engineer and Founder building products, systems, protocols, and technology companies."
    />
    <meta name="theme-color" content="#090909" />

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
  </head>
  <body
    class="antialiased relative h-screen w-screen bg-[#090909] text-white selection:bg-[#4F9DFF]/30 selection:text-white overflow-hidden"
  >
    <!-- Premium Grid and Dot Background -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <!-- Dot grid -->
      <div class="absolute inset-0 bg-[radial-gradient(#1f1f1f_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>
      <!-- Soft gradient overlay to fade grid towards margins -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_40%,#090909_100%)]"></div>
      <!-- Subtle accent light -->
      <div class="absolute -top-[30%] left-[20%] w-[60%] h-[60%] rounded-full bg-[radial-gradient(circle,rgba(79,157,255,0.03)_0%,transparent_70%)] blur-[80px]"></div>
    </div>

    <slot />

    <script>
      // Add subtle parallax effect to hero background
      window.addEventListener("scroll", () => {
        const scrolled = window.scrollY;
        const particles = document.getElementById("particles");
        if (particles && scrolled < window.innerHeight) {
          particles.style.transform = `translateY(${scrolled * 0.5}px)`;
        }
      });

      // Smooth reveal animation for elements
      const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            // Optional: stop observing once revealed
            // observer.unobserve(entry.target); 
          }
        });
      }, observerOptions);

      // Observe all elements with reveal-up class
      document.querySelectorAll(".reveal-up").forEach((el) => {
        observer.observe(el);
      });

      // Desktop card tilt & spotlight effect
      function initCardTilt() {
        if (window.innerWidth > 768) {
          document.querySelectorAll(".card-tilt").forEach((element) => {
            const card = element as HTMLElement;
            card.addEventListener("mousemove", (e: MouseEvent) => {
              const rect = card.getBoundingClientRect();
              
              // Spotlight coordinates
              const mouseX = e.clientX - rect.left;
              const mouseY = e.clientY - rect.top;
              card.style.setProperty('--mouse-x', `${mouseX}px`);
              card.style.setProperty('--mouse-y', `${mouseY}px`);

              // Tilt calculations
              const x = (mouseX) / rect.width - 0.5;
              const y = (mouseY) / rect.height - 0.5;

              const rotateY = x * 8;
              const rotateX = -y * 8;

              card.style.transform = `
								perspective(1000px) 
								translateZ(0) 
								rotateX(${rotateX}deg) 
								rotateY(${rotateY}deg)
								translateY(-4px)
							`;
            });

            card.addEventListener("mouseleave", () => {
              card.style.transform = "";
              card.style.setProperty('--mouse-x', `-1000px`); // hide spotlight
            });
          });
        }
      }
      initCardTilt();

      // Reinitialize on window resize
      let resizeTimeout: number;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = window.setTimeout(() => {
          initCardTilt();
        }, 150);
      });
    </script>
  </body>
</html>
