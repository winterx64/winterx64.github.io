---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "winterx64 - maker · dev · hardware",
  description = "Akhil B Xavier (winterx64) — Full Stack Developer & Hardware Enthusiast. IoT, web, and embedded systems.",
  image = "/assets/winter1x1.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://winterx64.github.io");
const socialImageURL = new URL(image, Astro.site ?? "https://winterx64.github.io");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Akhil B Xavier",
  "alternateName": "winterx64",
  "url": "https://winterx64.github.io",
  "image": new URL("/assets/winter1x1.jpg", Astro.site ?? "https://winterx64.github.io").toString(),
  "jobTitle": "Full Stack Developer & Hardware Enthusiast",
  "description": description,
  "sameAs": [
    "https://github.com/winterx64",
    "https://linkedin.com/in/winterx64"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "winterx64 Portfolio",
  "url": "https://winterx64.github.io",
  "description": description,
  "author": {
    "@type": "Person",
    "name": "Akhil B Xavier"
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Akhil B Xavier" />
    <meta
      name="keywords"
      content="winterx64, Akhil B Xavier, Full Stack Developer, Hardware Enthusiast, Embedded Systems, IoT, USMP, DropaNote, Portfolio"
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#05060a" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="winterx64" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:creator" content="@winterx64" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />

    <!-- Theme Initialization -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body
    class="antialiased relative min-h-screen selection:bg-neon/30 selection:text-white"
  >
    <!-- Enhanced particles background -->
    <div id="particles" aria-hidden="true">
      <svg
        class="w-full h-full"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id="particleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00f7ff" stop-opacity="0.03"></stop>
            <stop offset="50%" stop-color="#a855f7" stop-opacity="0.02"></stop>
            <stop offset="100%" stop-color="#00f7ff" stop-opacity="0.01"></stop>
          </linearGradient>
        </defs>
        <rect width="100%" height="100%" fill="url(#particleGrad)"></rect>
      </svg>
    </div>

    <slot />

    <script>
      // Add subtle parallax effect to hero background
      window.addEventListener("scroll", () => {
        const scrolled = window.scrollY;
        const particles = document.getElementById("particles");
        if (particles && scrolled < window.innerHeight) {
          particles.style.transform = `translateY(${scrolled * 0.5}px)`;
        }
      });

      // Smooth reveal animation for elements
      const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            // Optional: stop observing once revealed
            // observer.unobserve(entry.target); 
          }
        });
      }, observerOptions);

      // Observe all elements with reveal-up class
      document.querySelectorAll(".reveal-up").forEach((el) => {
        observer.observe(el);
      });

      // Desktop card tilt & spotlight effect
      function initCardTilt() {
        if (window.innerWidth > 768) {
          document.querySelectorAll(".card-tilt").forEach((element) => {
            const card = element as HTMLElement;
            card.addEventListener("mousemove", (e: MouseEvent) => {
              const rect = card.getBoundingClientRect();
              
              // Spotlight coordinates
              const mouseX = e.clientX - rect.left;
              const mouseY = e.clientY - rect.top;
              card.style.setProperty('--mouse-x', `${mouseX}px`);
              card.style.setProperty('--mouse-y', `${mouseY}px`);

              // Tilt calculations
              const x = (mouseX) / rect.width - 0.5;
              const y = (mouseY) / rect.height - 0.5;

              const rotateY = x * 8;
              const rotateX = -y * 8;

              card.style.transform = `
								perspective(1000px) 
								translateZ(0) 
								rotateX(${rotateX}deg) 
								rotateY(${rotateY}deg)
								translateY(-4px)
							`;
            });

            card.addEventListener("mouseleave", () => {
              card.style.transform = "";
              card.style.setProperty('--mouse-x', `-1000px`); // hide spotlight
            });
          });
        }
      }
      initCardTilt();

      // Reinitialize on window resize
      let resizeTimeout: number;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = window.setTimeout(() => {
          initCardTilt();
        }, 150);
      });
    </script>
  </body>
</html>
